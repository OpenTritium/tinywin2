{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "registry.server-manager-autostart",
  "version": "3.0.0",
  "title": "禁用服务器管理器自动启动",
  "description": "阻止 Server Manager 在管理员登录时自动启动；程序和管理功能仍可手动使用。",
  "category": "Background Experience",
  "riskLevel": "Low",
  "operation": {
    "resource": "registry.value",
    "action": "set",
    "spec": {
      "hive": "software",
      "values": [
        {
          "key": "Microsoft\\ServerManager",
          "name": "DoNotOpenServerManagerAtLogon",
          "type": "dword",
          "data": 1
        }
      ]
    }
  }
}