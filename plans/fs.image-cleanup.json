{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "fs.image-cleanup",
  "version": "2.0.0",
  "title": "清理构建产物与临时文件",
  "description": "精简镜像内的一次性内容：清空 Windows、默认用户和服务账户的临时目录、Windows Update 下载缓存、Delivery Optimization 缓存及 WER 报告队列（保留目录结构，相关服务重新启用后可重建）；并删除镜像构建、安装、升级和 Sysprep 产生的日志、临时 Panther 内容及崩溃转储。不删除 CBS/Servicing 元数据、不删除 WinRE。v2.0.0 起合并原 fs.image-setup-logs 计划。",
  "category": "Servicing",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "fs.path",
      "action": "remove",
      "spec": {
        "paths": [
          "Windows\\Temp\\*",
          "Windows\\Downloaded Program Files\\*",
          "Windows\\SoftwareDistribution\\Download\\*",
          "Windows\\ServiceProfiles\\LocalService\\AppData\\Local\\Temp\\*",
          "Windows\\ServiceProfiles\\NetworkService\\AppData\\Local\\Temp\\*",
          "Windows\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache\\*",
          "Users\\Default\\AppData\\Local\\Temp\\*",
          "Users\\Default\\AppData\\Local\\Microsoft\\Windows\\INetCache\\*",
          "ProgramData\\Microsoft\\Windows\\WER\\ReportArchive\\*",
          "ProgramData\\Microsoft\\Windows\\WER\\ReportQueue\\*",
          "ProgramData\\Microsoft\\Windows\\WER\\Temp\\*"
        ]
      }
    },
    {
      "resource": "fs.path",
      "action": "remove",
      "spec": {
        "paths": [
          "Windows\\Panther\\*",
          "Windows\\System32\\Sysprep\\Panther\\*",
          "Windows\\Logs\\*",
          "Windows\\INF\\setupapi.dev.log",
          "Windows\\INF\\setupapi.app.log",
          "Windows\\INF\\setupapi.offline.log",
          "Windows\\setupact.log",
          "Windows\\setuperr.log",
          "Windows\\memory.dmp",
          "Windows\\Minidump\\*",
          "Windows\\LiveKernelReports\\*"
        ]
      }
    }
  ]
}
