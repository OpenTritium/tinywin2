{
  "schemaVersion": 2,
  "id": "feature.server-backup",
  "version": "2.0.0",
  "title": "移除 Windows Server Backup",
  "description": "移除 Windows Server Backup 管理单元和可选功能。",
  "group": "Server",
  "risk": "Medium",
  "tier": "Standard",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "WindowsServerBackup",
          "WindowsServerBackupSnapin"
        ],
        "removePayload": true
      }
    }
  ]
}