{
  "schemaVersion": 3,
  "id": "service.ai-fabric",
  "version": "3.0.0",
  "title": "禁用 Windows AI Fabric 服务",
  "description": "禁用 WSAIFabricSvc（Copilot/AI 基础设施）。无 AI 负载的机器上是纯死重。",
  "category": "System",
  "riskLevel": "Low",
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ],
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "WSAIFabricSvc"
      ],
      "start": {
        "$map": {
          "parameter": "startMode",
          "cases": {
            "disabled": "disabled",
            "manual": "manual",
            "delayedAuto": "DelayedAuto",
            "auto": "auto"
          }
        }
      }
    }
  }
}