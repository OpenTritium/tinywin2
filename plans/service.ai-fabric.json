{
  "schemaVersion": 2,
  "id": "service.ai-fabric",
  "version": "2.0.0",
  "title": "禁用 Windows AI Fabric 服务",
  "description": "禁用 WSAIFabricSvc（Copilot/AI 基础设施）。无 AI 负载的机器上是纯死重。",
  "group": "System",
  "risk": "Low",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "WSAIFabricSvc"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ]
}
