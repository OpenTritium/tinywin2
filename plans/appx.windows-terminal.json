{
  "schemaVersion": 2,
  "id": "appx.windows-terminal",
  "version": "2.0.0",
  "title": "移除 Windows Terminal",
  "description": "移除预装 Windows Terminal；PowerShell 和命令提示符仍保留。",
  "group": "Applications",
  "risk": "Medium",
  "tier": "Standard",
  "execs": [
    {
      "resource": "appx.provisioned",
      "ensure": "absent",
      "with": {
        "patterns": [
          "Microsoft.WindowsTerminal"
        ]
      }
    }
  ]
}