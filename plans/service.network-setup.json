{
  "schemaVersion": 2,
  "id": "service.network-setup",
  "version": "2.0.0",
  "title": "网络设置服务改为手动",
  "description": "将 NetSetupSvc 改为手动启动。添加网卡/加入域时按需拉起，平时不占开机竞争。",
  "group": "Networking",
  "risk": "Low",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "manual",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "NetSetupSvc"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual"
            }
          }
        }
      }
    }
  ]
}
