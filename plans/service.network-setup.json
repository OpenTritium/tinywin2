{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.network-setup",
  "version": "3.0.0",
  "title": "网络设置服务改为手动",
  "description": "将 NetSetupSvc 改为手动启动。添加网卡/加入域时按需拉起，平时不占开机竞争。",
  "category": "Networking",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "NetSetupSvc"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "manual",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ]
}
