{
  "schemaVersion": 2,
  "id": "service.wpad",
  "version": "2.0.0",
  "title": "禁用 WinHTTP 代理自动发现",
  "description": "禁用 WinHttpAutoProxySvc（WPAD）。固定网络/无代理环境可禁；依赖 PAC 自动发现的环境保留。",
  "group": "Networking",
  "risk": "Low",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "WinHttpAutoProxySvc"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ]
}
