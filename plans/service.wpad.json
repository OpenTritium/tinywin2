{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "service.wpad",
  "version": "3.0.0",
  "title": "禁用 WinHTTP 代理自动发现",
  "description": "禁用 WinHttpAutoProxySvc（WPAD）。固定网络/无代理环境可禁；依赖 PAC 自动发现的环境保留。",
  "category": "Networking",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "configure",
      "spec": {
        "services": [
          "WinHttpAutoProxySvc"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ]
}
