{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "feature.xps",
  "version": "3.1.0",
  "title": "移除 XPS 查看器",
  "description": "移除 XPS Viewer 功能、按需功能包和能力载荷。",
  "category": "Documents",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "dism.capability",
      "action": "remove",
      "spec": {
        "capabilities": [
          "XPS.Viewer~~~~*"
        ]
      }
    },
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "Xps-Foundation-Xps-Viewer"
        ],
        "removePayload": true
      }
    }
  ]
}
