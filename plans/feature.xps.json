{
  "schemaVersion": 2,
  "id": "feature.xps",
  "version": "2.0.0",
  "title": "移除 XPS 查看器",
  "description": "移除 XPS Viewer 功能和按需功能包。",
  "group": "Documents",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "Xps-Foundation-Xps-Viewer"
        ],
        "removePayload": true
      }
    },
    {
      "resource": "dism.capability",
      "ensure": "absent",
      "with": {
        "capabilities": [
          "XPS.Viewer~~~~0.0.1.0"
        ]
      }
    }
  ]
}