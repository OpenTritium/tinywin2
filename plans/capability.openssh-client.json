{
  "schemaVersion": 2,
  "id": "capability.openssh-client",
  "version": "2.0.0",
  "title": "移除 OpenSSH 客户端",
  "description": "移除 ssh、scp 等 OpenSSH 客户端工具。",
  "group": "Networking",
  "risk": "Medium",
  "tier": "Standard",
  "execs": [
    {
      "resource": "dism.capability",
      "ensure": "absent",
      "with": {
        "capabilities": [
          "OpenSSH.Client~~~~0.0.1.0"
        ]
      }
    }
  ]
}