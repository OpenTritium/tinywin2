{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "fs.ie-developer-tools",
  "version": "1.0.0",
  "title": "移除 Internet Explorer F12 开发工具",
  "description": "移除 Internet Explorer F12 开发工具目录；不影响现代 Explorer、WinUI Shell 或中文输入法。依赖 IE 调试器和旧网页开发工具的程序将不可用。",
  "category": "Applications",
  "riskLevel": "Medium",
  "requires": [
    "fs.internet-explorer"
  ],
  "operation": {
    "resource": "fs.path",
    "action": "remove",
    "spec": {
      "paths": [
        "Windows\\System32\\F12",
        "Windows\\SysWOW64\\F12"
      ]
    }
  }
}
