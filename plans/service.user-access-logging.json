{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.user-access-logging",
  "version": "3.0.0",
  "title": "延迟启动 User Access Logging",
  "description": "将 User Access Logging Service 设置为延迟自动启动；保留服务器使用统计，但减少开机阶段的服务竞争。",
  "category": "Server",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "UALSVC"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "delayed": "DelayedAuto",
              "disabled": "disabled"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayed",
      "options": [
        {
          "value": "delayed",
          "label": "延迟启动",
          "riskLevel": "Low"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Medium"
        }
      ]
    }
  ]
}
