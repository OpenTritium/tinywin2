{
  "schemaVersion": 2,
  "id": "service.remote-registry",
  "version": "2.0.0",
  "title": "禁用远程注册表服务",
  "description": "禁用 RemoteRegistry，阻止其他设备读取或修改本机注册表。依赖远程注册表的管理工具将失效。",
  "group": "Remote Management",
  "risk": "High",
  "tier": "Expert",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "RemoteRegistry"
        ],
        "start": "disabled"
      }
    }
  ]
}