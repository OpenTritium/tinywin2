{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.remote-registry",
  "version": "3.0.0",
  "title": "禁用远程注册表服务",
  "description": "禁用 RemoteRegistry，阻止其他设备读取或修改本机注册表。依赖远程注册表的管理工具将失效。",
  "category": "Remote Management",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "RemoteRegistry"
        ],
        "start": "disabled"
      }
    }
  ]
}
