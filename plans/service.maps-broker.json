{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.maps-broker",
  "version": "3.0.0",
  "title": "禁用离线地图服务",
  "description": "禁用 Downloaded Maps Manager (MapsBroker)。离线地图下载与使用将不可用。",
  "category": "Background Services",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "MapsBroker"
        ],
        "start": "disabled"
      }
    }
  ]
}
