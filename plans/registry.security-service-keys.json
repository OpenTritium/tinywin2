{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "registry.security-service-keys",
  "version": "1.0.0",
  "title": "删除 Defender、SmartScreen 和安全中心服务注册项",
  "description": "删除已移除安全组件对应的 SCM 服务注册键，避免服务列表保留 Defender、SmartScreen/WebThreat 和 Windows 安全中心残留项。防火墙服务键不在本计划内；WinRE 不受影响。",
  "category": "Security",
  "riskLevel": "High",
  "operation": {
    "resource": "registry.value",
    "action": "remove",
    "spec": {
      "hive": "system",
      "deleteKeys": [
        "ControlSet001\\Services\\WinDefend",
        "ControlSet001\\Services\\Sense",
        "ControlSet001\\Services\\WdBoot",
        "ControlSet001\\Services\\WdFilter",
        "ControlSet001\\Services\\WdNisSvc",
        "ControlSet001\\Services\\WdNisDrv",
        "ControlSet001\\Services\\SecurityHealthService",
        "ControlSet001\\Services\\wscsvc",
        "ControlSet001\\Services\\webthreatdefsvc",
        "ControlSet001\\Services\\webthreatdefusersvc",
        "ControlSet001\\Services\\wtd",
        "ControlSet002\\Services\\WinDefend",
        "ControlSet002\\Services\\Sense",
        "ControlSet002\\Services\\WdBoot",
        "ControlSet002\\Services\\WdFilter",
        "ControlSet002\\Services\\WdNisSvc",
        "ControlSet002\\Services\\WdNisDrv",
        "ControlSet002\\Services\\SecurityHealthService",
        "ControlSet002\\Services\\wscsvc",
        "ControlSet002\\Services\\webthreatdefsvc",
        "ControlSet002\\Services\\webthreatdefusersvc",
        "ControlSet002\\Services\\wtd"
      ]
    }
  }
}
