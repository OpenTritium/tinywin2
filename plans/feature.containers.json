{
  "schemaVersion": 2,
  "id": "feature.containers",
  "version": "2.0.0",
  "title": "移除 Windows Containers",
  "description": "移除 Windows 容器、Host Networking Service 与软件定义网络组件。",
  "group": "Virtualization",
  "risk": "High",
  "tier": "Expert",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "Containers",
          "Containers-HNS",
          "Containers-SDN"
        ],
        "removePayload": true
      }
    }
  ]
}