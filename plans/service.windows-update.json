{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.windows-update",
  "version": "3.0.0",
  "title": "Windows Update 服务启动方式",
  "description": "wuauserv：manual 为 Windows 默认（触发启动，由 UsoSvc 与计划任务编排自动更新，FoD 如 OpenSSH Server 安装时也可被 DISM 显式拉起）。要彻底关闭自动更新，请搭配 registry.update-task-cache 计划（移除 UpdateOrchestrator/WindowsUpdate 计划任务树）。",
  "category": "Update Services",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "wuauserv"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "manual": "manual",
              "disabled": "disabled"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "手动（Windows 默认，更新正常流转）",
          "riskLevel": "Low"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "High"
        }
      ]
    }
  ]
}
