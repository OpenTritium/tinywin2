{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "service.tzautoupdate",
  "version": "3.0.0",
  "title": "禁用时区自动更新服务",
  "description": "移除 .NET Framework 4 后禁用依赖 tzsync.exe 的 tzautoupdate 服务。",
  "category": "Frameworks",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "tzautoupdate"
        ],
        "start": "disabled"
      }
    }
  ]
}
