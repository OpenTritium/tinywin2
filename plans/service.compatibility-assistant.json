{
  "schemaVersion": 2,
  "id": "service.compatibility-assistant",
  "version": "2.0.0",
  "title": "禁用程序兼容性助手",
  "description": "禁用 Program Compatibility Assistant；旧程序兼容性提示和自动问题报告将不可用。",
  "group": "Background Services",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "PcaSvc"
        ],
        "start": "disabled"
      }
    }
  ]
}