{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.compatibility-assistant",
  "version": "3.0.0",
  "title": "禁用程序兼容性助手",
  "description": "禁用 Program Compatibility Assistant；旧程序兼容性提示和自动问题报告将不可用。",
  "category": "Background Services",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "PcaSvc"
        ],
        "start": "disabled"
      }
    }
  ]
}
