{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "feature.bitlocker",
  "version": "3.0.0",
  "title": "移除 BitLocker 管理组件",
  "description": "移除 BitLocker 工具、网络解锁和远程管理扩展；BitLocker 卷加密配置与恢复管理将不可用。",
  "category": "Security",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "Bitlocker-Utilities",
          "BdeAducExtTool",
          "BitLocker-NetworkUnlock",
          "BitLocker-RemoteAdminTool"
        ],
        "removePayload": true
      }
    }
  ]
}
