{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "fs.extra-system-sounds",
  "version": "1.0.0",
  "title": "移除额外系统提示音",
  "description": "移除报警、铃声、语音反馈、设备管理和导航音效资源；保留常规 Windows 事件音效，音频播放和游戏声音不受影响。",
  "category": "Media",
  "riskLevel": "Low",
  "operation": {
    "resource": "fs.path",
    "action": "remove",
    "spec": {
      "paths": [
        "Windows\\Media\\Alarm*.wav",
        "Windows\\Media\\Ring*.wav",
        "Windows\\Media\\Speech *.wav",
        "Windows\\Media\\dm",
        "Windows\\Media\\Focus*.raw",
        "Windows\\Media\\GoBack*.raw",
        "Windows\\Media\\Hide*.raw",
        "Windows\\Media\\Invoke*.raw",
        "Windows\\Media\\MoveNext*.raw",
        "Windows\\Media\\MovePrevious*.raw",
        "Windows\\Media\\Show*.raw",
        "Windows\\Media\\*.mid"
      ]
    }
  }
}
