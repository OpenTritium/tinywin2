{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "feature.windows-admin-center",
  "version": "3.1.0",
  "title": "移除 Windows Admin Center 与 Azure Arc 安装器",
  "description": "移除预置的 Windows Admin Center 安装组件和 Azure Arc Setup(含按需能力)。",
  "category": "Server",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "dism.capability",
      "action": "remove",
      "spec": {
        "capabilities": [
          "AzureArcSetup~~~~"
        ]
      }
    },
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "WindowsAdminCenterSetup"
        ],
        "removePayload": true
      }
    }
  ]
}
