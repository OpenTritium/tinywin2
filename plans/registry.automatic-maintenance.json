{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "registry.automatic-maintenance",
  "version": "1.0.0",
  "title": "禁用自动维护",
  "description": "关闭 Windows 自动维护调度，系统将不再按计划自动执行维护任务；需要手动维护组件和排查系统健康问题。",
  "category": "Background Experience",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "Microsoft\\Windows NT\\CurrentVersion\\Schedule\\Maintenance",
            "name": "MaintenanceDisabled",
            "type": "dword",
            "data": 1
          }
        ]
      }
    }
  ]
}
