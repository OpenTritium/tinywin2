{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "registry.edge-update-residuals",
  "version": "1.0.0",
  "title": "清理 Edge Update 卸载注册项",
  "description": "删除 Microsoft Edge Update 卸载项及 Edge 浏览器更新产品注册残留。该计划只处理 SOFTWARE hive；Edge WebView2 的产品注册由 registry.edge-webview-residuals 单独处理。",
  "category": "Browser",
  "riskLevel": "Medium",
  "operation": {
    "resource": "registry.value",
    "action": "remove",
    "spec": {
      "hive": "software",
      "deleteKeys": [
        "WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge Update",
        "Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge Update",
        "WOW6432Node\\Microsoft\\EdgeUpdate\\Clients\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
        "WOW6432Node\\Microsoft\\EdgeUpdate\\ClientState\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
        "Microsoft\\EdgeUpdate\\Clients\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
        "Microsoft\\EdgeUpdate\\ClientState\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}"
      ]
    }
  }
}
