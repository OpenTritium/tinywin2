{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "feature.wsl",
  "version": "3.0.0",
  "title": "移除 Windows Subsystem for Linux",
  "description": "移除 WSL 与其虚拟机平台依赖；Linux 发行版将无法运行。",
  "category": "Virtualization",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "Microsoft-Windows-Subsystem-Linux",
          "VirtualMachinePlatform"
        ],
        "removePayload": true
      }
    }
  ]
}
