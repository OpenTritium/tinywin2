{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "registry.consumer-content",
  "version": "3.1.0",
  "title": "禁用消费者内容推广",
  "description": "隐藏 Windows Chat 图标,阻止自动安装消费者推荐应用,禁用资讯与兴趣入口,并阻止默认用户模板自动安装推荐应用。",
  "category": "Policies",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "Policies\\Microsoft\\Windows\\Windows Chat",
            "name": "ChatIcon",
            "type": "dword",
            "data": 3
          },
          {
            "key": "Policies\\Microsoft\\Windows\\CloudContent",
            "name": "DisableWindowsConsumerFeatures",
            "type": "dword",
            "data": 1
          },
          {
            "key": "Policies\\Microsoft\\Windows\\Windows Feeds",
            "name": "EnableFeeds",
            "type": "dword",
            "data": 0
          }
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "default",
        "values": [
          {
            "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
            "name": "SilentInstalledAppsEnabled",
            "type": "dword",
            "data": 0
          }
        ]
      }
    }
  ]
}
