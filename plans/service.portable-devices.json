{
  "schemaVersion": 2,
  "id": "service.portable-devices",
  "version": "2.0.0",
  "title": "禁用便携设备枚举服务",
  "description": "禁用 WPDBusEnum 与 RmSvc（便携设备/可移动存储枚举）。静态硬件的 VM 没有热插拔场景。",
  "group": "Server",
  "risk": "Low",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "WPDBusEnum",
          "RmSvc"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ]
}
