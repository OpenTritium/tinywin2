{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "registry.startup-residuals",
  "version": "4.0.0",
  "title": "清理开机自启动项",
  "description": "阻止软件在新用户登录时自动启动：删除本机与默认用户模板中的 Run、RunOnce 和 StartupApproved 注册表项，并清理公共与默认用户 Startup 文件夹中的快捷方式及脚本。用户仍可手动启动软件；服务、驱动和系统输入组件不受影响。v4.0.0 起合并原 fs.startup-shortcuts 计划。",
  "category": "Background Experience",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "software",
        "deleteKeys": [
          "Microsoft\\Windows\\CurrentVersion\\Run",
          "Microsoft\\Windows\\CurrentVersion\\RunOnce",
          "Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run",
          "Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\StartupFolder"
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "default-user",
        "deleteKeys": [
          "Software\\Microsoft\\Windows\\CurrentVersion\\Run",
          "Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce",
          "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run",
          "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\StartupFolder"
        ]
      }
    },
    {
      "resource": "fs.path",
      "action": "remove",
      "spec": {
        "paths": [
          "ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Startup",
          "Users\\Default\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup"
        ]
      }
    }
  ]
}
