{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "fs.security-deep-residuals",
  "version": "1.2.0",
  "title": "深度清理 Defender、SmartScreen 和 WebThreat 文件残留",
  "description": "在安全服务已禁用、策略已关闭的前提下，删除 Defender/SmartScreen/WebThreat 的运行库、驱动、管理模块和空目录。会失去 Defender PowerShell 管理命令、SmartScreen/WebThreat 组件和 Defender 驱动的离线恢复能力；不删除 WinRE。",
  "category": "Security",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "fs.path",
      "action": "remove",
      "spec": {
        "paths": [
          "Program Files (x86)\\Windows Defender",
          "Windows\\System32\\SecurityHealth",
          "Windows\\System32\\WebThreatDefSvc",
          "Windows\\System32\\smartscreen.dll",
          "Windows\\System32\\smartscreenps.dll",
          "Windows\\System32\\libsmartscreenn.dll",
          "Windows\\System32\\webthreatdefsvc.dll",
          "Windows\\System32\\webthreatdefusersvc.dll",
          "Windows\\System32\\ThreatAssessment.dll",
          "Windows\\System32\\ThreatExperienceManager.dll",
          "Windows\\System32\\ThreatIntelligence.dll",
          "Windows\\System32\\ThreatResponseEngine.dll",
          "Windows\\System32\\zh-CN\\SecurityHealthAgent.dll.mui",
          "Windows\\System32\\zh-CN\\securityhealthsso.dll.mui",
          "Windows\\System32\\zh-CN\\ThreatExperienceManager.dll.mui",
          "Windows\\System32\\zh-CN\\webthreatdefsvc.dll.mui",
          "Windows\\System32\\zh-CN\\webthreatdefusersvc.dll.mui",
          "Windows\\SysWOW64\\smartscreen.dll",
          "Windows\\SysWOW64\\smartscreenps.dll",
          "Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\Modules\\Defender",
          "Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\Modules\\DefenderPerformance",
          "Windows\\System32\\drivers\\WdBoot.sys",
          "Windows\\System32\\drivers\\WdDevFlt.sys",
          "Windows\\System32\\drivers\\WdFilter.sys",
          "Windows\\System32\\drivers\\WdNisDrv.sys",
          "Windows\\System32\\WindowsPowerShell\\v1.0\\Modules\\Defender",
          "Windows\\System32\\WindowsPowerShell\\v1.0\\Modules\\DefenderPerformance",
          "Windows\\System32\\migwiz\\replacementmanifests\\Security-Malware-Windows-Defender-Repl.man",
          "Windows\\PolicyDefinitions\\SmartScreen.admx",
          "Windows\\PolicyDefinitions\\WebThreatDefense.admx",
          "Windows\\PolicyDefinitions\\zh-CN\\SmartScreen.adml",
          "Windows\\PolicyDefinitions\\zh-CN\\WebThreatDefense.adml",
          "Windows\\ELAMBKUP\\WdBoot.sys"
        ]
      }
    }
  ]
}
