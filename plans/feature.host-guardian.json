{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "feature.host-guardian",
  "version": "3.0.0",
  "title": "移除 Host Guardian Service",
  "description": "移除 Host Guardian Service 及其包；无法部署受防护虚拟机基础结构。",
  "category": "Virtualization",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "HostGuardian",
          "HostGuardianService-Package"
        ],
        "removePayload": true
      }
    }
  ]
}
