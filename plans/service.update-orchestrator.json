{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.update-orchestrator",
  "version": "3.2.0",
  "title": "更新会话编排器 (UsoSvc) 启动方式",
  "description": "UsoSvc：auto 为 Windows 默认（自动启动，编排更新会话与重启仲裁）；manual 按需拉起；disabled 彻底禁用（设置页的 Windows Update 交互会受影响）。",
  "category": "Update Services",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "UsoSvc"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "auto": "auto",
              "disabled": "disabled",
              "manual": "manual"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "自动（Windows 默认）",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动（按需）",
          "riskLevel": "Low"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Medium"
        }
      ]
    }
  ]
}
