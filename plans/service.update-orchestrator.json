{
  "schemaVersion": 2,
  "id": "service.update-orchestrator",
  "version": "2.0.0",
  "title": "禁用更新会话编排器 (UsoSvc)",
  "description": "禁用 Update Session Orchestrator。精简镜像通常不打算再接收更新；恢复更新前需改回手动/自动。",
  "group": "Update Services",
  "risk": "Medium",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Medium"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "UsoSvc"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual"
            }
          }
        }
      }
    }
  ]
}
