{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "service.push-notifications",
  "version": "3.0.0",
  "title": "禁用 Windows 推送通知",
  "description": "禁用 Windows Push Notifications 系统服务；Toast 通知和部分应用实时提醒将不可用。",
  "category": "Background Services",
  "riskLevel": "Medium",
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "WpnService",
        "WpnUserService"
      ],
      "start": "disabled"
    }
  }
}