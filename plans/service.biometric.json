{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.biometric",
  "version": "3.0.0",
  "title": "禁用 Windows 生物识别服务",
  "description": "禁用 Windows Biometric Service；指纹、人脸和其他 Windows 生物识别登录将不可用。",
  "category": "Devices",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "WbioSrvc"
        ],
        "start": "disabled"
      }
    }
  ]
}
