{
  "schemaVersion": 2,
  "id": "service.connected-devices-platform",
  "version": "2.0.0",
  "title": "禁用 Connected Devices Platform",
  "description": "禁用跨设备体验平台；附近共享、跨设备活动和部分设备配对体验将不可用。",
  "group": "Background Services",
  "risk": "Medium",
  "tier": "Standard",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "CDPSvc",
          "CDPUserSvc"
        ],
        "start": "disabled"
      }
    }
  ]
}