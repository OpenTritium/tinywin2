{
  "schemaVersion": 3,
  "id": "registry.edge-smartscreen",
  "version": "3.0.0",
  "title": "关闭 Edge SmartScreen",
  "description": "关闭 Microsoft Edge SmartScreen 和潜在有害应用检查。仅适合已移除 Edge 或受控测试镜像。",
  "category": "Security",
  "riskLevel": "High",
  "operation": {
    "resource": "registry.value",
    "action": "set",
    "spec": {
      "hive": "software",
      "values": [
        {
          "key": "Policies\\Microsoft\\Edge",
          "name": "SmartScreenEnabled",
          "type": "dword",
          "data": 0
        },
        {
          "key": "Policies\\Microsoft\\Edge",
          "name": "SmartScreenPuaEnabled",
          "type": "dword",
          "data": 0
        }
      ]
    }
  }
}