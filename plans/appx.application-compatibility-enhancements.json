{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "appx.application-compatibility-enhancements",
  "version": "1.0.0",
  "title": "移除应用程序兼容性增强",
  "description": "移除 Microsoft.ApplicationCompatibilityEnhancements 预置 AppX；应用程序兼容性增强和部分旧程序兼容性修复将不可用。该组件与 PcaSvc 程序兼容性助手服务不同，删除后可能影响旧版软件、Office 安装器和部分游戏启动器。",
  "category": "Applications",
  "riskLevel": "Medium",
  "operation": {
    "resource": "appx.provisioned",
    "action": "remove",
    "spec": {
      "patterns": [
        "Microsoft.ApplicationCompatibilityEnhancements*"
      ]
    }
  }
}
