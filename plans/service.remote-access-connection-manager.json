{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.remote-access-connection-manager",
  "version": "3.0.0",
  "title": "禁用远程访问连接管理器",
  "description": "禁用 RasMan 和 SSTP 服务；VPN、拨号连接和部分远程访问客户端将不可用。",
  "category": "Remote Access",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "RasMan",
          "SstpSvc"
        ],
        "start": "disabled"
      }
    }
  ]
}
