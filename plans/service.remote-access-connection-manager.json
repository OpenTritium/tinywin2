{
  "schemaVersion": 2,
  "id": "service.remote-access-connection-manager",
  "version": "2.0.0",
  "title": "禁用远程访问连接管理器",
  "description": "禁用 RasMan 和 SSTP 服务；VPN、拨号连接和部分远程访问客户端将不可用。",
  "group": "Remote Access",
  "risk": "Medium",
  "tier": "Expert",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "RasMan",
          "SstpSvc"
        ],
        "start": "disabled"
      }
    }
  ]
}