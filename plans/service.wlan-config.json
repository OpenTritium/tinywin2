{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.wlan-config",
  "version": "3.1.0",
  "title": "WLAN 服务裁剪",
  "description": "v3.1.0：新增禁用 WlanSvc（WLAN AutoConfig）——本机为有线 virtio 网卡、无无线硬件，保留只会白耗句柄；Wcmsvc（连接管理器）改为延迟自动启动，它同时服务有线网络，不可停。",
  "category": "Networking",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "WlanSvc"
        ],
        "start": "disabled"
      }
    },
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "Wcmsvc"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayedAuto",
      "options": [
        {
          "value": "delayedAuto",
          "label": "延迟启动",
          "riskLevel": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ]
}
