{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "service.wlan-config",
  "version": "3.0.0",
  "title": "WLAN 配置服务改为延迟启动",
  "description": "Wcmsvc 改为延迟自动启动。桌面网络配置不急于开机瞬间。",
  "category": "Networking",
  "riskLevel": "Low",
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayedAuto",
      "options": [
        {
          "value": "delayedAuto",
          "label": "延迟启动",
          "riskLevel": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ],
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "Wcmsvc"
      ],
      "start": {
        "$map": {
          "parameter": "startMode",
          "cases": {
            "disabled": "disabled",
            "manual": "manual",
            "delayedAuto": "DelayedAuto",
            "auto": "auto"
          }
        }
      }
    }
  }
}