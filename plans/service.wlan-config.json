{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.wlan-config",
  "version": "3.2.0",
  "title": "WLAN 服务裁剪",
  "description": "v3.2.0：Wcmsvc（Windows Connection Manager）在纯有线镜像上一并禁用——实测其唯一依赖方是 WlanSvc（enumdepend 仅此一个），两者同时禁用则依赖链自洽；有线数据面走 DHCP/NLA/Netman，不经 WCM。v3.1.0：新增禁用 WlanSvc（WLAN AutoConfig）——本机为有线 virtio 网卡、无无线硬件。若部署目标未来使用 Wi-Fi，将此计划两处改回 delayedAuto 即可恢复。",
  "category": "Networking",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "WlanSvc"
        ],
        "start": "disabled"
      }
    },
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "Wcmsvc"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayedAuto",
      "options": [
        {
          "value": "delayedAuto",
          "label": "延迟启动",
          "riskLevel": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ]
}
