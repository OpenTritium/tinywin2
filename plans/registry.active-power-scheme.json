{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "registry.active-power-scheme",
  "version": "1.1.0",
  "title": "默认电源方案",
  "description": "将活动电源方案设为所选内置方案：平衡（381b4222）、高性能（8c5e7fda，默认）或卓越性能（e9a42b02）。高性能减少空闲降频与定时器合并带来的交互延迟；卓越性能面向高端台式机，禁用几乎所有省电微调。注意实测局限：离线写入的 ActivePowerScheme 会被电源服务在首次启动时用默认方案覆盖，因此对在线部署（经 setup.exe specialize 之外）的镜像不生效；需在系统内以 powercfg /setactive 或无人值守 FirstLogonCommand 执行。裸机装机则保留离线值。卓越性能需要镜像 User\\PowerSchemes 中存在该方案 payload（26100 已内置，可用 powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61 重新物化）。选高性能或卓越性能时功耗与发热上升。",
  "category": "Policies",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "system",
        "values": [
          {
            "key": "ControlSet001\\Power",
            "name": "ActivePowerScheme",
            "type": "string",
            "data": {
              "$map": {
                "parameter": "scheme",
                "cases": {
                  "balanced": "381b4222-f694-41f0-9685-ff5bb260df2e",
                  "high": "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c",
                  "ultimate": "e9a42b02-d5df-448d-aa00-03f14749eb61"
                }
              }
            }
          },
          {
            "key": "ControlSet002\\Power",
            "name": "ActivePowerScheme",
            "type": "string",
            "data": {
              "$map": {
                "parameter": "scheme",
                "cases": {
                  "balanced": "381b4222-f694-41f0-9685-ff5bb260df2e",
                  "high": "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c",
                  "ultimate": "e9a42b02-d5df-448d-aa00-03f14749eb61"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "parameters": [
    {
      "name": "scheme",
      "type": "enum",
      "label": "电源方案",
      "default": "high",
      "options": [
        {
          "value": "high",
          "label": "高性能（减少空闲降频，交互延迟最低）",
          "riskLevel": "Low"
        },
        {
          "value": "balanced",
          "label": "平衡（Windows 默认）",
          "riskLevel": "Low"
        },
        {
          "value": "ultimate",
          "label": "卓越性能（禁用几乎全部省电微调，功耗最高）",
          "riskLevel": "Medium"
        }
      ]
    }
  ]
}
