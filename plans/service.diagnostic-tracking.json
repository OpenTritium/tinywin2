{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.diagnostic-tracking",
  "version": "3.0.0",
  "title": "禁用诊断跟踪服务",
  "description": "禁用 Connected User Experiences and Telemetry 服务 (DiagTrack)，避免非必要诊断后台常驻。",
  "category": "Background Services",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "DiagTrack"
        ],
        "start": "disabled"
      }
    }
  ]
}
