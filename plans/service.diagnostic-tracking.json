{
  "schemaVersion": 2,
  "id": "service.diagnostic-tracking",
  "version": "2.0.0",
  "title": "禁用诊断跟踪服务",
  "description": "禁用 Connected User Experiences and Telemetry 服务 (DiagTrack)，避免非必要诊断后台常驻。",
  "group": "Background Services",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "DiagTrack"
        ],
        "start": "disabled"
      }
    }
  ]
}