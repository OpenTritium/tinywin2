{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "feature.media",
  "version": "3.1.0",
  "title": "移除媒体播放组件",
  "description": "移除 Media Playback、Windows Media Player(含按需能力)与 Server Media Foundation。",
  "category": "Media",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "dism.capability",
      "action": "remove",
      "spec": {
        "capabilities": [
          "Media.WindowsMediaPlayer~~~~*"
        ]
      }
    },
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "MediaPlayback",
          "WindowsMediaPlayer",
          "ServerMediaFoundation"
        ],
        "removePayload": true
      }
    }
  ]
}
