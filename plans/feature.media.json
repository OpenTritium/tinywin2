{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "feature.media",
  "version": "3.0.0",
  "title": "移除媒体播放组件",
  "description": "移除 Media Playback、Windows Media Player 与 Server Media Foundation。",
  "category": "Media",
  "riskLevel": "Medium",
  "requires": [
    "capability.media-windows-media-player"
  ],
  "operation": {
    "resource": "dism.feature",
    "action": "remove",
    "spec": {
      "features": [
        "MediaPlayback",
        "WindowsMediaPlayer",
        "ServerMediaFoundation"
      ],
      "removePayload": true
    }
  }
}