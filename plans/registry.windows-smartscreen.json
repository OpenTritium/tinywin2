{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "registry.windows-smartscreen",
  "version": "3.0.0",
  "title": "关闭 Windows SmartScreen",
  "description": "关闭 Windows Shell SmartScreen 检查。未知应用和下载将失去 Windows SmartScreen 信誉防护；仅适合受控离线镜像。",
  "category": "Security",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.value",
      "action": "set",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "Policies\\Microsoft\\Windows\\System",
            "name": "EnableSmartScreen",
            "type": "dword",
            "data": 0
          },
          {
            "key": "Microsoft\\Windows\\CurrentVersion\\Explorer",
            "name": "SmartScreenEnabled",
            "type": "string",
            "data": "Off"
          }
        ]
      }
    }
  ]
}
