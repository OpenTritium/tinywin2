{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "fs.edge-legacy-platform",
  "version": "1.0.0",
  "title": "移除旧 EdgeHTML 兼容层",
  "description": "删除 Internet Explorer/旧 EdgeHTML 使用的双架构兼容库和内容进程；现代 Edge 浏览器已由 component.edge 移除，独立 WebView2 与 Windows OneCore WebView 保留。依赖旧版 WebView、IE 模式或 EdgeHTML 的程序将不可用。",
  "category": "Browser",
  "riskLevel": "High",
  "requires": [
    "fs.internet-explorer"
  ],
  "operation": {
    "resource": "fs.path",
    "action": "remove",
    "spec": {
      "paths": [
        "Windows\\System32\\edgeangle.dll",
        "Windows\\System32\\EdgeContent.dll",
        "Windows\\System32\\edgehtml.dll",
        "Windows\\System32\\edgeIso.dll",
        "Windows\\System32\\EdgeManager.dll",
        "Windows\\System32\\EdgeResetPlugin.dll",
        "Windows\\System32\\MicrosoftEdgeBCHost.exe",
        "Windows\\System32\\MicrosoftEdgeCP.exe",
        "Windows\\System32\\MicrosoftEdgeDevTools.exe",
        "Windows\\System32\\MicrosoftEdgeSH.exe",
        "Windows\\SysWOW64\\edgeangle.dll",
        "Windows\\SysWOW64\\EdgeContent.dll",
        "Windows\\SysWOW64\\edgehtml.dll",
        "Windows\\SysWOW64\\edgeIso.dll",
        "Windows\\SysWOW64\\EdgeManager.dll",
        "Windows\\SysWOW64\\EdgeResetPlugin.dll",
        "Windows\\SysWOW64\\MicrosoftEdgeBCHost.exe",
        "Windows\\SysWOW64\\MicrosoftEdgeCP.exe",
        "Windows\\SysWOW64\\MicrosoftEdgeDevTools.exe",
        "Windows\\SysWOW64\\MicrosoftEdgeSH.exe"
      ]
    }
  }
}
