{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "feature.search",
  "version": "3.0.0",
  "title": "移除 Windows Search",
  "description": "移除 Windows Search 索引和搜索组件；资源管理器搜索能力会受影响。",
  "category": "System",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "SearchEngine-Client-Package",
          "File-Services-Search-Service"
        ],
        "removePayload": true
      }
    }
  ]
}
