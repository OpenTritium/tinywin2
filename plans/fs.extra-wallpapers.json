{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "fs.extra-wallpapers",
  "version": "1.0.0",
  "title": "移除额外壁纸和锁屏图片",
  "description": "移除 Windows 主题壁纸、Spotlight、扩展壁纸和额外锁屏图片；保留 Windows\\img0.jpg 作为默认桌面壁纸。",
  "category": "Desktop Experience",
  "riskLevel": "Low",
  "operation": {
    "resource": "fs.path",
    "action": "remove",
    "spec": {
      "paths": [
        "Windows\\Web\\Wallpaper\\Extended",
        "Windows\\Web\\Wallpaper\\Spotlight",
        "Windows\\Web\\Wallpaper\\ThemeA",
        "Windows\\Web\\Wallpaper\\ThemeB",
        "Windows\\Web\\Wallpaper\\ThemeC",
        "Windows\\Web\\Wallpaper\\ThemeD",
        "Windows\\Web\\Wallpaper\\Windows\\img19.jpg",
        "Windows\\Web\\Screen"
      ]
    }
  }
}
