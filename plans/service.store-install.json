{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.store-install",
  "version": "3.1.0",
  "title": "禁用商店应用安装服务",
  "description": "禁用 Microsoft Store 安装和 PushToInstall 服务；镜像不再支持商店应用安装和推送安装。ClipSVC 改为 manual 而非禁用：收件箱 Windows Terminal 等 WinUI 应用启动时经它验证许可证，禁用会导致终端无法打开。AppX Deployment Service 保留以保证系统组件注册。",
  "category": "Background Services",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "InstallService",
          "PushToInstall"
        ],
        "start": "disabled"
      }
    },
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "ClipSVC"
        ],
        "start": "manual"
      }
    }
  ]
}
