{
  "schemaVersion": 2,
  "id": "service.volume-shadow-copy",
  "version": "2.0.0",
  "title": "禁用卷影副本服务",
  "description": "禁用 VSS。不做系统快照/备份的 VM 可禁（注意：部分备份软件依赖它）。",
  "group": "Storage",
  "risk": "Medium",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Medium"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "VSS"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ]
}
