{
  "schemaVersion": 3,
  "id": "feature.network-policy-server",
  "version": "3.0.0",
  "title": "移除 Network Policy Server",
  "description": "移除 NPS/RADIUS 服务器及管理工具；网络访问策略、RADIUS 身份验证和记账将不可用。",
  "category": "Server Roles",
  "riskLevel": "High",
  "operation": {
    "resource": "dism.feature",
    "action": "remove",
    "spec": {
      "features": [
        "NPAS-Role",
        "NPSManagementTools",
        "NPSMMC"
      ],
      "removePayload": true
    }
  }
}