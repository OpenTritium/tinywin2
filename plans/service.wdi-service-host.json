{
  "schemaVersion": 2,
  "id": "service.wdi-service-host",
  "version": "1.0.0",
  "title": "将服务诊断主机改为按需启动",
  "description": "将 WdiServiceHost 改为手动启动。该服务尚未单独完成 Desktop Experience 禁用验证，因此本 plan 不提供 disabled 模式。",
  "group": "Diagnostics",
  "risk": "Medium",
  "tier": "Standard",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "WdiServiceHost"
        ],
        "start": "Manual"
      }
    }
  ]
}
