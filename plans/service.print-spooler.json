{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "service.print-spooler",
  "version": "3.0.0",
  "title": "禁用打印后台处理服务",
  "description": "禁用 Print Spooler (Spooler)。本地和网络打印、打印到 PDF 将不可用。",
  "category": "Background Services",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "Spooler",
          "PrintScanBrokerService"
        ],
        "servicePatterns": [
          "PrintWorkflowUserSvc*"
        ],
        "start": "disabled"
      }
    }
  ]
}
