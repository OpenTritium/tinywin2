{
  "schemaVersion": 2,
  "id": "service.print-spooler",
  "version": "2.0.0",
  "title": "禁用打印后台处理服务",
  "description": "禁用 Print Spooler (Spooler)。本地和网络打印、打印到 PDF 将不可用。",
  "group": "Background Services",
  "risk": "High",
  "tier": "Expert",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "Spooler"
        ],
        "start": "disabled"
      }
    }
  ]
}