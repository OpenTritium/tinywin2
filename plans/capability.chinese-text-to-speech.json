{
  "schemaVersion": 2,
  "id": "capability.chinese-text-to-speech",
  "version": "2.0.0",
  "title": "移除中文文本转语音",
  "description": "移除简体中文文本转语音引擎。",
  "group": "Language",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
