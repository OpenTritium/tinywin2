{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "service.bluetooth",
  "version": "3.0.0",
  "title": "禁用蓝牙服务",
  "description": "禁用 Bluetooth Support Service 及蓝牙用户服务；蓝牙键鼠、耳机和其他蓝牙设备将不可用。",
  "category": "Devices",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "bthserv",
          "BluetoothUserService",
          "BTAGService"
        ],
        "start": "disabled"
      }
    }
  ]
}
