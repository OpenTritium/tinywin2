{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.workstation",
  "version": "3.0.0",
  "title": "延迟启动 Workstation 服务",
  "description": "将 LanmanWorkstation 设置为延迟自动启动；保留 SMB 客户端，但开机初期访问网络共享可能稍慢。",
  "category": "Networking",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "LanmanWorkstation"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "delayed": "DelayedAuto",
              "disabled": "disabled"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayed",
      "options": [
        {
          "value": "delayed",
          "label": "延迟启动",
          "riskLevel": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "High"
        }
      ]
    }
  ]
}
