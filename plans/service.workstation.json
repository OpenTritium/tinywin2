{
  "schemaVersion": 2,
  "id": "service.workstation",
  "version": "2.0.0",
  "title": "延迟启动 Workstation 服务",
  "description": "将 LanmanWorkstation 设置为延迟自动启动；保留 SMB 客户端，但开机初期访问网络共享可能稍慢。",
  "group": "Networking",
  "risk": "Medium",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayed",
      "options": [
        {
          "value": "delayed",
          "label": "延迟启动",
          "risk": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "High"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "LanmanWorkstation"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "delayed": "DelayedAuto",
              "disabled": "disabled"
            }
          }
        }
      }
    }
  ]
}