{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "service.event-collector",
  "version": "3.0.0",
  "title": "禁用 Windows 事件收集器",
  "description": "禁用 Windows Event Collector (Wecsvc)。订阅式事件转发和集中日志收集将不可用。",
  "category": "Remote Management",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "configure",
      "spec": {
        "services": [
          "Wecsvc"
        ],
        "start": "disabled"
      }
    }
  ]
}
