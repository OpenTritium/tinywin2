{
  "schemaVersion": 3,
  "id": "service.diagnostic-policy",
  "version": "3.0.0",
  "title": "将 Diagnostic Policy Service 改为按需启动",
  "description": "将 Diagnostic Policy Service（DPS）改为手动启动；保留需要时的故障诊断触发能力，减少开机常驻。WdiServiceHost 和 WdiSystemHost 已拆分为独立 plan。",
  "category": "Diagnostics",
  "riskLevel": "Medium",
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Medium"
        }
      ]
    }
  ],
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "DPS"
      ],
      "start": {
        "$map": {
          "parameter": "startMode",
          "cases": {
            "manual": "Manual",
            "disabled": "disabled"
          }
        }
      }
    }
  }
}