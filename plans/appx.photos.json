{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "appx.photos",
  "version": "3.0.0",
  "title": "移除照片",
  "description": "移除 Microsoft Photos 预置 Appx；照片查看和照片编辑功能将不可用。",
  "category": "Applications",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "appx.provisioned",
      "action": "remove",
      "spec": {
        "patterns": [
          "Microsoft.Windows.Photos"
        ]
      }
    }
  ]
}
