{
  "schemaVersion": 2,
  "id": "appx.feedback-hub",
  "version": "2.0.0",
  "title": "移除反馈中心",
  "description": "移除 Windows Feedback Hub 预装 Appx。",
  "group": "Applications",
  "risk": "Medium",
  "tier": "Standard",
  "execs": [
    {
      "resource": "appx.provisioned",
      "ensure": "absent",
      "with": {
        "patterns": [
          "Microsoft.WindowsFeedbackHub"
        ]
      }
    }
  ]
}