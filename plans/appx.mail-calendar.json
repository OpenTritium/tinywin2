{
  "schemaVersion": 2,
  "id": "appx.mail-calendar",
  "version": "2.0.0",
  "title": "移除邮件和日历",
  "description": "移除 Windows Communications Apps 预置包；邮件和日历客户端将不可用。",
  "group": "Applications",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
      "resource": "appx.provisioned",
      "ensure": "absent",
      "with": {
        "patterns": [
          "microsoft.windowscommunicationsapps"
        ]
      }
    }
  ]
}