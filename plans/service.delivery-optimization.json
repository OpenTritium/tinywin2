{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "service.delivery-optimization",
  "version": "3.0.0",
  "title": "禁用 Delivery Optimization",
  "description": "禁用 Delivery Optimization；Windows Update 将回退到传统下载，局域网和互联网更新共享不可用。",
  "category": "Update Services",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "configure",
      "spec": {
        "services": [
          "DoSvc"
        ],
        "start": "disabled"
      }
    }
  ]
}
