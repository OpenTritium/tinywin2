{
  "schemaVersion": 2,
  "id": "service.performance-logs",
  "version": "2.0.0",
  "title": "禁用性能日志服务",
  "description": "禁用 Performance Logs & Alerts；Data Collector Set 和依赖 PLA 的性能采集将不可用。",
  "group": "Diagnostics",
  "risk": "Medium",
  "tier": "Expert",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "pla"
        ],
        "start": "disabled"
      }
    }
  ]
}