{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.performance-logs",
  "version": "3.0.0",
  "title": "禁用性能日志服务",
  "description": "禁用 Performance Logs & Alerts；Data Collector Set 和依赖 PLA 的性能采集将不可用。",
  "category": "Diagnostics",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "pla"
        ],
        "start": "disabled"
      }
    }
  ]
}
