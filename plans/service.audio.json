{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "service.audio",
  "version": "3.0.0",
  "title": "禁用 Windows 音频服务",
  "description": "禁用 Audiosrv 和 AudioEndpointBuilder；系统音频输出、录音以及依赖音频会话的应用将不可用。",
  "category": "Devices",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.service",
      "action": "configure",
      "spec": {
        "services": [
          "Audiosrv",
          "AudioEndpointBuilder"
        ],
        "start": "disabled"
      }
    }
  ]
}
