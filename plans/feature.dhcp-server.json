{
  "schemaVersion": 2,
  "id": "feature.dhcp-server",
  "version": "2.0.0",
  "title": "移除 DHCP Server",
  "description": "移除 DHCP 服务器角色及管理工具；本机不能为网络客户端分配 DHCP 地址。",
  "group": "Server Roles",
  "risk": "High",
  "tier": "Expert",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "DHCPServer",
          "DHCPServer-Tools"
        ],
        "removePayload": true
      }
    }
  ]
}