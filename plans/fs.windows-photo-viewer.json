{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "fs.windows-photo-viewer",
  "version": "2.0.0",
  "title": "移除经典照片查看器",
  "description": "完整移除经典 Windows Photo Viewer：32/64 位文件目录、RegisteredApplications 注册入口，以及能力、文件关联、COM 和已注册应用残留注册项；不删除 Explorer 缩略图/预览相关 shimgvw.dll。v2.0.0 起合并原 registry.photo-viewer-registration 与 registry.photo-viewer-residuals 计划。",
  "category": "Applications",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "fs.path",
      "action": "remove",
      "spec": {
        "paths": [
          "Program Files\\Windows Photo Viewer",
          "Program Files (x86)\\Windows Photo Viewer"
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "RegisteredApplications",
            "name": "Windows Photo Viewer"
          }
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "software",
        "deleteKeys": [
          "Microsoft\\Windows Photo Viewer\\Capabilities",
          "Classes\\Microsoft.Photos.ViewerDropTarget",
          "Classes\\Microsoft.Photos.ViewerGalleryInterface",
          "Classes\\CLSID\\{D63A1416-FCEC-4431-862F-E8056223DD03}",
          "Classes\\CLSID\\{32624F4B-F1D5-4877-989E-555640109D2B}",
          "Classes\\Applications\\photoviewer.dll"
        ]
      }
    }
  ]
}
