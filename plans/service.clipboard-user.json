{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "service.clipboard-user",
  "version": "3.0.0",
  "title": "禁用剪贴板用户服务",
  "description": "禁用每用户 Clipboard User Service；剪贴板历史、跨设备剪贴板和部分剪贴板同步功能将不可用。",
  "category": "Background Services",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "servicePatterns": [
          "cbdhsvc_*"
        ],
        "start": "disabled"
      }
    }
  ]
}
