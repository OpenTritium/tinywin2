{
  "schemaVersion": 2,
  "id": "service.clipboard-user",
  "version": "2.0.0",
  "title": "禁用剪贴板用户服务",
  "description": "禁用每用户 Clipboard User Service；剪贴板历史、跨设备剪贴板和部分剪贴板同步功能将不可用。",
  "group": "Background Services",
  "risk": "Medium",
  "tier": "Standard",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "servicePatterns": [
          "cbdhsvc_*"
        ],
        "start": "disabled"
      }
    }
  ]
}