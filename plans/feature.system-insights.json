{
  "schemaVersion": 2,
  "id": "feature.system-insights",
  "version": "2.0.0",
  "title": "移除 System Insights",
  "description": "移除 System Insights 预测分析服务和管理工具；基于历史指标的容量与性能预测将不可用。",
  "group": "Diagnostics",
  "risk": "Medium",
  "tier": "Expert",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "SystemInsights",
          "SystemInsightsManagement"
        ],
        "removePayload": true
      }
    }
  ]
}