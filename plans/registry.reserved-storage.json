{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "registry.reserved-storage",
  "version": "3.0.0",
  "title": "关闭保留存储策略",
  "description": "设置 ReserveManager 的 ShippedWithReserves 标志为 0，阻止系统按保留存储策略预留空间；该策略主要影响安装后的磁盘占用，不会明显缩小 WIM，需在 VM 中单独确认。",
  "category": "Storage",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.value",
      "action": "set",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "Microsoft\\Windows\\CurrentVersion\\ReserveManager",
            "name": "ShippedWithReserves",
            "type": "dword",
            "data": 0
          }
        ]
      }
    }
  ]
}
