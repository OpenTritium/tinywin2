{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "registry.chat",
  "version": "3.0.0",
  "title": "隐藏聊天入口",
  "description": "将 Windows Chat 图标设置为隐藏。",
  "category": "Policies",
  "riskLevel": "Low",
  "operation": {
    "resource": "registry.value",
    "action": "set",
    "spec": {
      "hive": "software",
      "values": [
        {
          "key": "Policies\\Microsoft\\Windows\\Windows Chat",
          "name": "ChatIcon",
          "type": "dword",
          "data": 3
        }
      ]
    }
  }
}