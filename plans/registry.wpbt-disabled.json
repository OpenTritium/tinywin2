{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "registry.wpbt-disabled",
  "version": "1.0.0",
  "title": "禁用 WPBT 执行",
  "description": "禁止 Windows 执行固件 ACPI WPBT 中注入的启动程序，避免 OEM 在每次启动时部署额外软件。",
  "category": "System",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.value",
      "action": "set",
      "spec": {
        "hive": "system",
        "values": [
          {
            "key": "ControlSet001\\Control\\Session Manager",
            "name": "DisableWpbtExecution",
            "type": "dword",
            "data": 1
          },
          {
            "key": "ControlSet002\\Control\\Session Manager",
            "name": "DisableWpbtExecution",
            "type": "dword",
            "data": 1
          }
        ]
      }
    }
  ]
}
