{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "registry.windows-firewall",
  "version": "3.0.0",
  "title": "禁用 Windows 防火墙",
  "description": "将域、专用和公用网络配置文件的防火墙策略设为关闭。设备暴露在不受信任网络时风险极高。",
  "category": "Security",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "Policies\\Microsoft\\WindowsFirewall\\DomainProfile",
            "name": "EnableFirewall",
            "type": "dword",
            "data": 0
          },
          {
            "key": "Policies\\Microsoft\\WindowsFirewall\\PrivateProfile",
            "name": "EnableFirewall",
            "type": "dword",
            "data": 0
          },
          {
            "key": "Policies\\Microsoft\\WindowsFirewall\\PublicProfile",
            "name": "EnableFirewall",
            "type": "dword",
            "data": 0
          }
        ]
      }
    }
  ]
}
