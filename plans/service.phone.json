{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "service.phone",
  "version": "3.0.0",
  "title": "禁用 Phone Service",
  "description": "禁用 Phone Service；Phone Link、移动电话集成和部分移动宽带功能将不可用。",
  "category": "Background Services",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "PhoneSvc"
        ],
        "start": "disabled"
      }
    }
  ]
}
