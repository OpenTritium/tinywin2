{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "feature.iis",
  "version": "3.0.0",
  "title": "移除 Internet Information Services",
  "description": "移除 IIS Web Server Role 和 Hostable Web Core payload；无法再部署 IIS 网站或依赖该 Web Core 的应用。",
  "category": "Server Roles",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "IIS-WebServerRole",
          "IIS-HostableWebCore"
        ],
        "removePayload": true
      }
    }
  ]
}
