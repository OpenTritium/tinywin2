{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "registry.edge-residuals",
  "version": "2.0.0",
  "title": "清理 Edge 浏览器与更新残留",
  "description": "Edge 浏览器本体移除后的注册表残留集中清理：产品、卸载、AppX 和 IFEO 注册项，SYSTEM hive 中的 edgeupdate/edgeupdatem 服务注册键，以及 SOFTWARE hive 中的 Edge Update 卸载项和更新产品注册残留。保留 Edge WebView2 产品 GUID、EdgeUpdate 引擎和 WebView2 运行时；独立 WebView2 运行时的文件与注册由 fs.edge-webview-runtime 单独处理。v2.0.0 起合并原 edge-browser-residuals、edge-update-cleanup、edge-update-residuals 计划。",
  "category": "Browser",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "software",
        "deleteKeys": [
          "WOW6432Node\\Microsoft\\EdgeUpdate\\Clients\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
          "WOW6432Node\\Microsoft\\EdgeUpdate\\ClientState\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
          "WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge",
          "Microsoft\\MicrosoftEdge",
          "Microsoft\\Windows\\CurrentVersion\\MicrosoftEdge",
          "Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\MicrosoftEdgeUpdate.exe",
          "Microsoft\\Windows\\CurrentVersion\\Appx\\AppxAllUserStore\\Config\\Microsoft.MicrosoftEdge.Stable_8wekyb3d8bbwe",
          "Microsoft\\Windows\\CurrentVersion\\Appx\\AppxAllUserStore\\Config\\Microsoft.MicrosoftEdge_8wekyb3d8bbwe",
          "Microsoft\\WindowsUpdate\\Orchestrator\\UScheduler_Oobe\\EdgeUpdate"
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "system",
        "deleteKeys": [
          "ControlSet001\\Services\\edgeupdate",
          "ControlSet001\\Services\\edgeupdatem",
          "ControlSet002\\Services\\edgeupdate",
          "ControlSet002\\Services\\edgeupdatem"
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "software",
        "deleteKeys": [
          "WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge Update",
          "Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge Update",
          "WOW6432Node\\Microsoft\\EdgeUpdate\\Clients\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
          "WOW6432Node\\Microsoft\\EdgeUpdate\\ClientState\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
          "Microsoft\\EdgeUpdate\\Clients\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}",
          "Microsoft\\EdgeUpdate\\ClientState\\{56EB18F8-B008-4CBD-B6D2-8C97FE7E9062}"
        ]
      }
    }
  ]
}
