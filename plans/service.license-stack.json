{
  "schemaVersion": 2,
  "id": "service.license-stack",
  "version": "2.0.0",
  "title": "禁用商店授权服务三件套",
  "description": "禁用 LicenseManager、TokenBroker 与 wlidsvc（Microsoft 账户/商店授权栈）。离线精简镜像不用商店与 MSA，三个服务是纯内存开销（约 3 个 svchost）。",
  "group": "Policies",
  "risk": "Low",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "LicenseManager",
          "TokenBroker",
          "wlidsvc"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ]
}
