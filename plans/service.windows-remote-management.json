{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "service.windows-remote-management",
  "version": "3.0.0",
  "title": "禁用 Windows 远程管理",
  "description": "禁用 WinRM。PowerShell Remoting、Windows Admin Center 和多数远程服务器管理流程将不可用。",
  "category": "Remote Management",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "registry.service",
      "action": "configure",
      "spec": {
        "services": [
          "WinRM"
        ],
        "start": "disabled"
      }
    }
  ]
}
