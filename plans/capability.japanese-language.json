{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "capability.japanese-language",
  "version": "3.0.0",
  "title": "移除日语输入、字体和语言能力",
  "description": "移除日语语言基础、输入、字体、手写、OCR、语音和文本转语音能力；日语显示与输入将不可用。",
  "category": "Languages",
  "riskLevel": "High",
  "operation": {
    "resource": "dism.capability",
    "action": "remove",
    "spec": {
      "capabilities": [
        "Language.Basic~~~ja-JP~*",
        "Language.Fonts.Jpan~~~und-JPAN~*",
        "Language.Handwriting~~~ja-JP~*",
        "Language.OCR~~~ja-JP~*",
        "Language.Speech~~~ja-JP~*",
        "Language.TextToSpeech~~~ja-JP~*"
      ]
    }
  }
}
