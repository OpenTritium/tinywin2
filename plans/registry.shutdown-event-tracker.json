{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "registry.shutdown-event-tracker",
  "version": "3.0.0",
  "title": "关闭关机原因询问窗口",
  "description": "关闭 Windows Server Shutdown Event Tracker，不再在关机或重启后要求填写原因；不影响正常关机、重启或事件日志记录。",
  "category": "System",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "Policies\\Microsoft\\Windows NT\\Reliability",
            "name": "ShutdownReasonOn",
            "type": "dword",
            "data": 0
          },
          {
            "key": "Policies\\Microsoft\\Windows NT\\Reliability",
            "name": "ShutdownReasonUI",
            "type": "dword",
            "data": 0
          },
          {
            "key": "Policies\\Microsoft\\Windows NT\\Reliability",
            "name": "ShutdownReasonUIEx",
            "type": "dword",
            "data": 0
          }
        ]
      }
    }
  ]
}
