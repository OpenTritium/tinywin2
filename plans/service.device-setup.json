{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "service.device-setup",
  "version": "3.0.0",
  "title": "禁用设备安装管理服务",
  "description": "禁用 DsmSvc。硬件冻结的镜像不安装新驱动；需要接入新硬件时改回手动。",
  "category": "Server",
  "riskLevel": "Low",
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ],
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "DsmSvc"
      ],
      "start": {
        "$map": {
          "parameter": "startMode",
          "cases": {
            "disabled": "disabled",
            "manual": "manual",
            "delayedAuto": "DelayedAuto",
            "auto": "auto"
          }
        }
      }
    }
  }
}