{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "service.windows-health-optimized-experiences",
  "version": "3.0.0",
  "title": "禁用 Windows 健康状况和优化体验服务",
  "description": "禁用 whesvc 后停止 Windows 健康状况和优化体验后台服务；当前 Desktop Experience Hyper-V VM 已完成热禁用、重启和桌面验证。该服务提供的健康/优化体验后台功能不可用。",
  "category": "Background Services",
  "riskLevel": "Medium",
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "whesvc"
      ],
      "start": "disabled"
    }
  }
}
