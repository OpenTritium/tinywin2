{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.link-discovery",
  "version": "3.0.0",
  "title": "禁用链路发现驱动服务",
  "description": "禁用 LLTDIO 与 RSPNDR（链路层拓扑发现/响应器）。网络发现功能已移除后这两个内核驱动是残留。",
  "category": "Networking",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "lltdio",
          "rspndr"
        ],
        "start": "disabled"
      }
    }
  ]
}
