{
  "schemaVersion": 2,
  "id": "service.display-broker",
  "version": "2.0.0",
  "title": "禁用显示代理服务",
  "description": "禁用 DispBrokerDesktopSvc（显示设置代理）。Headless / 无交互会话的 VM 可禁用。",
  "group": "System",
  "risk": "Low",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "DispBrokerDesktopSvc"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual"
            }
          }
        }
      }
    }
  ]
}
