{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "service.display-broker",
  "version": "3.0.0",
  "title": "禁用显示代理服务",
  "description": "禁用 DispBrokerDesktopSvc（显示设置代理）。Headless / 无交互会话的 VM 可禁用。",
  "category": "System",
  "riskLevel": "Low",
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ],
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "DispBrokerDesktopSvc"
      ],
      "start": {
        "$map": {
          "parameter": "startMode",
          "cases": {
            "disabled": "disabled",
            "manual": "manual"
          }
        }
      }
    }
  }
}