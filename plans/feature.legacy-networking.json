{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "feature.legacy-networking",
  "version": "3.0.0",
  "title": "移除遗留网络功能",
  "description": "移除 Remote Assistance、PeerDist、WINS 和 Network Load Balancing 服务器载荷；普通家庭网络、现代 SMB 和常见游戏联网不受影响。",
  "category": "Networking",
  "riskLevel": "Low",
  "operation": {
    "resource": "dism.feature",
    "action": "remove",
    "spec": {
      "features": [
        "RemoteAssistance",
        "PeerDist",
        "WINSRuntime",
        "NetworkLoadBalancingFullServer"
      ],
      "removePayload": true
    }
  }
}
