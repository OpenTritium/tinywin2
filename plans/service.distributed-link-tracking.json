{
  "schemaVersion": 2,
  "id": "service.distributed-link-tracking",
  "version": "2.0.0",
  "title": "禁用分布式链接跟踪",
  "description": "禁用 Distributed Link Tracking 客户端和服务器服务；NTFS 文件移动跟踪以及部分域环境链接维护将不可用。",
  "group": "Background Services",
  "risk": "Medium",
  "tier": "Expert",
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "TrkWks",
          "TrkSvr"
        ],
        "start": "disabled"
      }
    }
  ]
}