{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.distributed-link-tracking",
  "version": "3.0.0",
  "title": "禁用分布式链接跟踪",
  "description": "禁用 Distributed Link Tracking 客户端和服务器服务；NTFS 文件移动跟踪以及部分域环境链接维护将不可用。",
  "category": "Background Services",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "TrkWks",
          "TrkSvr"
        ],
        "start": "disabled"
      }
    }
  ]
}
