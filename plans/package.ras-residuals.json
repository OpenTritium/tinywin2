{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "package.ras-residuals",
  "version": "1.0.0",
  "title": "移除远程访问服务端残留包",
  "description": "移除 RRAS / 远程访问的服务端部署包与 RemoteAccess PowerShell 管理模块包。feature.remote-access 已移除对应功能，这里清理仍以 CBS 包形式存在的载荷。保留 Microsoft-OneCore-RasSstp-Api-Package，维持 SSTP VPN 客户端兼容。",
  "category": "Remote Access",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "dism.package",
      "action": "remove",
      "spec": {
        "patterns": [
          "^Microsoft-Windows-Networking-RemoteAccess-PowerShell-Base-Package~.*$",
          "^Microsoft-Windows-OneCoreUAP-RRAS-ServerCore-Deployment-Package~.*$"
        ]
      }
    }
  ]
}
