{
  "schemaVersion": 3,
  "id": "feature.printing",
  "version": "3.0.0",
  "title": "移除打印与 Microsoft Print to PDF",
  "description": "移除本地打印客户端、图形打印组件和 Microsoft Print to PDF。",
  "category": "Devices",
  "riskLevel": "High",
  "operation": {
    "resource": "dism.feature",
    "action": "remove",
    "spec": {
      "features": [
        "Printing-Client",
        "Printing-Client-Gui",
        "Printing-PrintToPDFServices-Features",
        "Microsoft-Windows-Printing-PremiumTools"
      ],
      "removePayload": true
    }
  }
}