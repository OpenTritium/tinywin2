{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "feature.snmp",
  "version": "3.0.0",
  "title": "移除 SNMP 组件",
  "description": "移除 SNMP、RSAT SNMP 工具和 WMI SNMP Provider；基于 SNMP 的监控和设备管理将不可用。",
  "category": "Networking",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "SNMP",
          "Server-RSAT-SNMP",
          "WMISnmpProvider"
        ],
        "removePayload": true
      }
    }
  ]
}
