{
  "schemaVersion": 3,
  "id": "registry.consumer-features",
  "version": "3.0.0",
  "title": "禁用消费者体验",
  "description": "阻止 Windows 自动安装推荐的消费者应用。",
  "category": "Policies",
  "riskLevel": "Low",
  "operation": {
    "resource": "registry.value",
    "action": "set",
    "spec": {
      "hive": "software",
      "values": [
        {
          "key": "Policies\\Microsoft\\Windows\\CloudContent",
          "name": "DisableWindowsConsumerFeatures",
          "type": "dword",
          "data": 1
        }
      ]
    }
  }
}