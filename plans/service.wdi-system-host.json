{
  "schemaVersion": 2,
  "id": "service.wdi-system-host",
  "version": "1.0.0",
  "title": "配置系统诊断主机启动方式",
  "description": "配置 WdiSystemHost 的启动方式。禁用模式已在 Desktop Experience Hyper-V VM 中完成重启和桌面功能验证；默认仍为手动以保持通用 profile 保守。",
  "group": "Diagnostics",
  "risk": "Medium",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "手动",
          "risk": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Medium"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "WdiSystemHost"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "manual": "Manual",
              "disabled": "disabled"
            }
          }
        }
      }
    }
  ]
}
