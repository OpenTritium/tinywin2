{
  "schemaVersion": 2,
  "id": "feature.distributed-file-system",
  "version": "2.0.0",
  "title": "移除分布式文件系统命名空间",
  "description": "移除 DFS Namespace Server；无法托管 DFS 命名空间。",
  "group": "Server Roles",
  "risk": "High",
  "tier": "Expert",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "DFSN-Server"
        ],
        "removePayload": true
      }
    }
  ]
}