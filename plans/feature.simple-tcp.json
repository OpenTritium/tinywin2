{
  "schemaVersion": 2,
  "id": "feature.simple-tcp",
  "version": "2.0.0",
  "title": "移除简单 TCP/IP 服务",
  "description": "移除 Simple TCP/IP Services；Echo、Discard、Daytime、Character Generator 和 Quote of the Day 服务不可用。",
  "group": "Networking",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "SimpleTCP"
        ],
        "removePayload": true
      }
    }
  ]
}