{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "appx.application-compatibility-enhancements-residuals",
  "version": "1.0.0",
  "title": "移除应用程序兼容性增强系统组件残留",
  "description": "清理 Microsoft.ApplicationCompatibilityEnhancements 的 SystemApps 目录和离线 AppX 注册；用于补足预置 AppX 移除后仍出现在设置系统组件列表中的残留。应用程序兼容性增强和部分旧程序兼容性修复将不可用。",
  "category": "Applications",
  "riskLevel": "Medium",
  "requires": [
    "appx.application-compatibility-enhancements"
  ],
  "operation": {
    "resource": "appx.system",
    "action": "remove",
    "spec": {
      "patterns": [
        "Microsoft.ApplicationCompatibilityEnhancements*"
      ]
    }
  }
}
