{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "feature.multipoint-services",
  "version": "3.0.0",
  "title": "移除 MultiPoint Services",
  "description": "移除 MultiPoint Services 连接器、服务和工具；无法提供多点桌面会话。",
  "category": "Server Roles",
  "riskLevel": "High",
  "operations": [
    {
      "resource": "dism.feature",
      "action": "remove",
      "spec": {
        "features": [
          "MultiPoint-Connector",
          "MultiPoint-Connector-Services",
          "MultiPoint-Tools"
        ],
        "removePayload": true
      }
    }
  ]
}
