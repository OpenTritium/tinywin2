{
  "schemaVersion": 2,
  "id": "feature.iscsi-target",
  "version": "2.0.0",
  "title": "移除 iSCSI Target 存储提供程序",
  "description": "移除 iSCSI Target Storage Providers；无法作为 iSCSI 目标提供存储。",
  "group": "Storage",
  "risk": "High",
  "tier": "Expert",
  "execs": [
    {
      "resource": "dism.feature",
      "ensure": "absent",
      "with": {
        "features": [
          "iSCSITargetStorageProviders"
        ],
        "removePayload": true
      }
    }
  ]
}