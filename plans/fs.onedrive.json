{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "fs.onedrive",
  "version": "4.0.0",
  "title": "移除 OneDrive",
  "description": "完整移除 OneDrive：安装器、WinSxS/CBS 残留、图标、用户同步目录、快捷方式和离线任务文件，并清理默认用户 NTUSER.DAT 中的 OneDrive 残余配置与首次登录触发安装的 Run/RunOnce 启动项，避免新建用户重新安装同步客户端。不存在的路径安全跳过。v4.0.0 起合并原 registry.onedrive-profile 与 registry.onedrive-startup 计划。",
  "category": "Applications",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "fs.path",
      "action": "remove",
      "spec": {
        "paths": [
          "Windows\\System32\\OneDriveSetup.exe",
          "Windows\\SysWOW64\\OneDriveSetup.exe",
          "Windows\\System32\\OneDrive.ico",
          "Windows\\System32\\Tasks\\OneDrive*",
          "Windows\\servicing\\Packages\\Microsoft-Windows-OneDrive-Setup-*",
          "Windows\\WinSxS\\*microsoft-windows-onedrive-setup_*",
          "Windows\\WinSxS\\Manifests\\*microsoft-windows-onedrive-setup*",
          "Windows\\WinSxS\\FileMaps\\*onedrive-setup*",
          "Windows\\System32\\CatRoot\\*\\*OneDrive-Setup-*",
          "Users\\*\\AppData\\Local\\Microsoft\\OneDrive",
          "Users\\*\\AppData\\Local\\Microsoft\\OneDriveSetup",
          "Users\\*\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\OneDrive.lnk",
          "ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\OneDrive.lnk"
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "default-user",
        "deleteKeys": [
          "Software\\Microsoft\\OneDrive"
        ]
      }
    },
    {
      "resource": "registry.value",
      "action": "remove",
      "spec": {
        "hive": "default-user",
        "values": [
          {
            "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Run",
            "name": "OneDriveSetup"
          },
          {
            "key": "Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce",
            "name": "OneDriveSetup"
          }
        ]
      }
    }
  ]
}
