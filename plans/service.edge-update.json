{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "service.edge-update",
  "version": "3.0.0",
  "title": "禁用 Microsoft Edge 更新服务",
  "description": "禁用 edgeupdate 和 edgeupdatem；Edge 不会自动更新，依赖 Edge WebView/Edge 的组件可能停留在旧版本。",
  "category": "Browser",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "edgeupdate",
          "edgeupdatem"
        ],
        "start": "disabled"
      }
    }
  ]
}
