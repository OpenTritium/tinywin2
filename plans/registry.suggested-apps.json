{
  "schemaVersion": 2,
  "id": "registry.suggested-apps",
  "version": "2.0.0",
  "title": "禁用推荐应用安装",
  "description": "阻止默认用户配置自动安装推荐应用。",
  "group": "Policies",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
      "resource": "registry.value",
      "ensure": "present",
      "with": {
        "hive": "default",
        "values": [
          {
            "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
            "name": "SilentInstalledAppsEnabled",
            "type": "dword",
            "data": 0
          }
        ]
      }
    }
  ]
}