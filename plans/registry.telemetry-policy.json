{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "registry.telemetry-policy",
  "version": "1.0.0",
  "title": "策略层强制关闭诊断遥测",
  "description": "写入数据收集策略总开关（AllowTelemetry=0，Server/企业版支持 Security 级别）。与移除 DiagTrack 等服务的计划互补：即使未来组件被重新供给，诊断数据上报仍在策略层保持关闭。",
  "category": "Policies",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "software",
        "values": [
          {
            "key": "Policies\\Microsoft\\Windows\\DataCollection",
            "name": "AllowTelemetry",
            "type": "dword",
            "data": 0
          }
        ]
      }
    }
  ]
}
