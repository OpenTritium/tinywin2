{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 4,
  "id": "service.inventory",
  "version": "3.0.0",
  "title": "禁用清单与兼容性评估服务",
  "description": "禁用 InventorySvc；硬件/软件清单收集和兼容性评估后台任务将不可用。",
  "category": "Diagnostics",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "registry.service",
      "action": "apply",
      "spec": {
        "services": [
          "InventorySvc"
        ],
        "start": "disabled"
      }
    }
  ]
}
