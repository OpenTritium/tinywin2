{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "appx.family",
  "version": "1.0.0",
  "title": "移除 Microsoft Family",
  "description": "移除 MicrosoftCorporationII.MicrosoftFamily 预置 Appx；Windows Family 家庭安全功能不可用。",
  "category": "Applications",
  "riskLevel": "Medium",
  "operations": [
    {
      "resource": "appx.provisioned",
      "action": "remove",
      "spec": {
        "patterns": [
          "MicrosoftCorporationII.MicrosoftFamily*"
        ]
      }
    }
  ]
}
