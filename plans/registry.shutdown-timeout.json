{
  "$schema": "../schemas/plan-v5.schema.json",
  "schemaVersion": 5,
  "id": "registry.shutdown-timeout",
  "version": "1.0.0",
  "title": "缩短关机服务终止超时",
  "description": "将 WaitToKillServiceTimeout 从默认 5000ms 降到 2000ms（ReviOS 同类调整）；关机/重启不再等待慢服务退出。运行中未保存数据的服务被强杀的窗口变大，开发机可接受。",
  "category": "Policies",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.value",
      "action": "apply",
      "spec": {
        "hive": "system",
        "values": [
          {
            "key": "ControlSet001\\Control",
            "name": "WaitToKillServiceTimeout",
            "type": "string",
            "data": "2000"
          },
          {
            "key": "ControlSet002\\Control",
            "name": "WaitToKillServiceTimeout",
            "type": "string",
            "data": "2000"
          }
        ]
      }
    }
  ]
}
