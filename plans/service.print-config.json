{
  "$schema": "../schemas/plan-v4.schema.json",
  "schemaVersion": 4,
  "id": "service.print-config",
  "version": "3.0.0",
  "title": "禁用打印设备配置服务",
  "description": "禁用 PrintDeviceConfigurationService。VM 与无打印环境可直接禁用；需要打印时改回手动。",
  "category": "Server",
  "riskLevel": "Low",
  "operations": [
    {
      "resource": "registry.service",
      "action": "configure",
      "spec": {
        "services": [
          "PrintDeviceConfigurationService"
        ],
        "start": {
          "$map": {
            "parameter": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ]
}
