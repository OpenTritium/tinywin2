{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "registry.security-tasks",
  "version": "1.0.0",
  "title": "删除安全防护计划任务注册项",
  "description": "删除 Defender、Sense、ExploitGuard 刷新和 TPM 预认证健康检查的任务树注册项。计划任务文件由 fs.security-residuals 配套清理；不会删除 TPM 日常维护任务。",
  "category": "Security",
  "riskLevel": "High",
  "operation": {
    "resource": "registry.value",
    "action": "remove",
    "spec": {
      "hive": "software",
      "deleteKeys": [
        "Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\Windows Defender",
        "Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\Sense",
        "Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\ExploitGuard",
        "Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\TPM\\Tpm-PreAttestationHealthCheck"
      ]
    }
  }
}
