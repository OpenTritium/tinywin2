{
  "schemaVersion": 2,
  "id": "service.server",
  "version": "2.0.0",
  "title": "延迟启动 Server 文件共享服务",
  "description": "将 LanmanServer 设置为延迟自动启动；保留 SMB 文件共享，但登录初期共享可能暂时不可用。",
  "group": "Networking",
  "risk": "Medium",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayed",
      "options": [
        {
          "value": "delayed",
          "label": "延迟启动",
          "risk": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "High"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "LanmanServer"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "delayed": "DelayedAuto",
              "disabled": "disabled"
            }
          }
        }
      }
    }
  ]
}