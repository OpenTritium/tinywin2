{
  "schemaVersion": 3,
  "id": "service.server",
  "version": "3.0.0",
  "title": "延迟启动 Server 文件共享服务",
  "description": "将 LanmanServer 设置为延迟自动启动；保留 SMB 文件共享，但登录初期共享可能暂时不可用。",
  "category": "Networking",
  "riskLevel": "Medium",
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayed",
      "options": [
        {
          "value": "delayed",
          "label": "延迟启动",
          "riskLevel": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "High"
        }
      ]
    }
  ],
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "LanmanServer"
      ],
      "start": {
        "$map": {
          "parameter": "startMode",
          "cases": {
            "delayed": "DelayedAuto",
            "disabled": "disabled"
          }
        }
      }
    }
  }
}