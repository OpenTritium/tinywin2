{
  "schemaVersion": 2,
  "id": "appx.bing-weather",
  "version": "2.0.0",
  "title": "移除 Bing 天气",
  "description": "移除 Microsoft Bing Weather 预装 Appx。",
  "group": "Applications",
  "risk": "Low",
  "tier": "Standard",
  "execs": [
    {
      "resource": "appx.provisioned",
      "ensure": "absent",
      "with": {
        "patterns": [
          "Microsoft.BingWeather"
        ]
      }
    }
  ]
}