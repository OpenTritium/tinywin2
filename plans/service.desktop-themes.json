{
  "$schema": "../schemas/plan-v3.schema.json",
  "schemaVersion": 3,
  "id": "service.desktop-themes",
  "version": "3.0.0",
  "title": "主题服务改为延迟启动",
  "description": "Themes 改为延迟自动启动。桌面视觉栈在登录后再初始化；追求极致可选手动/禁用（会退回经典灰框）。",
  "category": "System",
  "riskLevel": "Medium",
  "parameters": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "delayedAuto",
      "options": [
        {
          "value": "delayedAuto",
          "label": "延迟启动",
          "riskLevel": "Medium"
        },
        {
          "value": "disabled",
          "label": "禁用",
          "riskLevel": "Medium"
        },
        {
          "value": "manual",
          "label": "手动",
          "riskLevel": "Low"
        }
      ]
    }
  ],
  "operation": {
    "resource": "registry.service",
    "action": "configure",
    "spec": {
      "services": [
        "Themes"
      ],
      "start": {
        "$map": {
          "parameter": "startMode",
          "cases": {
            "disabled": "disabled",
            "manual": "manual",
            "delayedAuto": "DelayedAuto",
            "auto": "auto"
          }
        }
      }
    }
  }
}