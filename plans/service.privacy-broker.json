{
  "schemaVersion": 2,
  "id": "service.privacy-broker",
  "version": "2.0.0",
  "title": "禁用隐私功能访问与网络连接代理",
  "description": "禁用 camsvc（功能访问管理器）与 NcbService（网络连接代理）。两者都是 Store 应用配套，精简镜像无消费者。",
  "group": "Policies",
  "risk": "Low",
  "tier": "Standard",
  "arguments": [
    {
      "name": "startMode",
      "type": "enum",
      "label": "启动方式",
      "default": "disabled",
      "options": [
        {
          "value": "disabled",
          "label": "禁用",
          "risk": "Low"
        },
        {
          "value": "manual",
          "label": "手动",
          "risk": "Low"
        }
      ]
    }
  ],
  "execs": [
    {
      "resource": "registry.service",
      "ensure": "present",
      "with": {
        "services": [
          "camsvc",
          "NcbService"
        ],
        "start": {
          "$map": {
            "arg": "startMode",
            "cases": {
              "disabled": "disabled",
              "manual": "manual",
              "delayedAuto": "DelayedAuto",
              "auto": "auto"
            }
          }
        }
      }
    }
  ]
}
