root = true

# ---- defaults ------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,manifest}]
indent_size = 2

[*.xaml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---- C# style ------------------------------------------------------------
[*.cs]
max_line_length = 120
# dotnet format + EnforceCodeStyleInBuild enforce these at build time.
csharp_style_namespace_declarations = file_scoped:warning
# K&R: open braces stay on the same line (none = everywhere).
csharp_new_line_before_open_brace = none

# Blank lines: method bodies stay tight.
# - dotnet format never inserts/removes single blank lines (verified experimentally);
#   these two steer VS/Rider "format document" away from adding them.
dotnet_style_allow_statement_immediately_after_block_experimental = true
dotnet_style_allow_multiple_blank_lines_experimental = false
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_throw_expression = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_qualification_for_event = false:warning
dotnet_style_operator_placement_when_wrapping = beginning_of_line
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0051.severity = warning # unused private members would fail the build

# License-free file headers are fine; no header rule.

[*.{cs,csproj}]
# Analyzers: .NET analyzers are on by default for net10; warnings are errors via TreatWarningsAsErrors.
