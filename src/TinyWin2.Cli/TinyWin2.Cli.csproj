<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>2.0.0-alpha1</Version>
    <AssemblyInformationalVersion>2.0.0-alpha1</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RootNamespace>TinyWin2.Cli</RootNamespace>
    <AssemblyName>tinywin2</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyWin2.Core\TinyWin2.Core.csproj"/>
    <PackageReference Include="System.CommandLine" Version="2.0.11"/>
  </ItemGroup>

</Project>
