<?xml version="1.0" encoding="utf-8"?>

<Page
  x:Class="TinyWin2.Gui.Pages.ItemsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:TinyWin2.Gui.Pages"
  xmlns:gui="using:TinyWin2.Gui">

  <Grid ColumnDefinitions="*,380" Padding="16,8,16,16">
    <!-- left: grouped plan list -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" Grid.Column="0" Margin="0,0,12,0">
      <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0">
        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索精简项…" Width="320" TextChanged="SearchChanged" />
        <Button Content="全不选" Click="SelectNone" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="1" Margin="0,8,0,0">
        <Button Content="导入 Profile…" Click="ImportProfile" />
        <Button Content="导出 Profile…" Click="ExportProfile" />
        <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Foreground="Gray" />
      </StackPanel>

      <ListView x:Name="PlanList" Grid.Row="3" SelectionChanged="PlanSelected" Margin="0,8,0,0">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:RowItem">
            <ContentControl Content="{x:Bind}" IsTabStop="False" HorizontalContentAlignment="Stretch">
              <ContentControl.ContentTemplateSelector>
                <local:RowTemplateSelector>
                  <local:RowTemplateSelector.HeaderTemplate>
                    <DataTemplate x:DataType="local:RowItem">
                      <StackPanel Orientation="Horizontal" Spacing="8" Background="#F0F0F0" Padding="8,6"
                                  Margin="0,10,0,2" CornerRadius="4">
                        <TextBlock Text="{x:Bind Header}" FontWeight="Bold" VerticalAlignment="Center" />
                        <CheckBox Content="全选本组" Checked="GroupCheckChanged" Unchecked="GroupCheckChanged"
                                  Tag="{x:Bind Header}" MinWidth="0" />
                        <TextBlock Text="{x:Bind Count}" Foreground="Gray" VerticalAlignment="Center" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </local:RowTemplateSelector.HeaderTemplate>
                  <local:RowTemplateSelector.PlanTemplate>
                    <DataTemplate x:DataType="gui:PlanItemViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,4">
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" />
                        <TextBlock Text="{x:Bind RiskBadge}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{x:Bind RiskBrush}" Width="28" />
                        <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Id}" Foreground="Gray" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Summary}" Foreground="#0058A0" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </local:RowTemplateSelector.PlanTemplate>
                </local:RowTemplateSelector>
              </ContentControl.ContentTemplateSelector>
            </ContentControl>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <!-- right: detail + arg editors -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="10" Padding="16,0,0,0">
        <TextBlock x:Name="DetailTitle" Text="选择一项查看详情" Style="{ThemeResource SubtitleTextBlockStyle}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="DetailId" Foreground="Gray" FontSize="12" />
        <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" />
        <StackPanel x:Name="ArgumentPanel" Spacing="12" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
          <Button Content="← 上一步" Click="GoBack" />
          <Button Content="开始构建 →" Style="{ThemeResource AccentButtonStyle}" Click="StartBuild" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
