<?xml version="1.0" encoding="utf-8"?>

<Page
  x:Class="TinyWin2.Gui.Pages.SourcePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel Spacing="{StaticResource PageSpacing}" Padding="24,8,24,24" MaxWidth="860" HorizontalAlignment="Left">

      <TextBlock Text="选择安装源" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="SourceBox" PlaceholderText="ISO、媒体文件夹、install.wim 或 install.esd" Width="560"
                 KeyDown="SourceBox_KeyDown" />
        <Button Content="浏览文件…" Click="PickInput" />
        <Button Content="浏览文件夹…" Click="PickFolder" />
      </StackPanel>
      <ProgressRing x:Name="IndexSpinner" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />

      <TextBlock Text="镜像索引" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ComboBox x:Name="IndexCombo" Width="560" SelectionChanged="IndexSelected"
                PlaceholderText="选择源后自动列出索引" />

      <TextBlock Text="输出" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="OutputFormatCombo" Width="240" SelectionChanged="OutputFormatSelected">
          <ComboBoxItem Content="ESD 镜像" Tag="esd" IsSelected="True" />
          <ComboBoxItem Content="WIM 镜像" Tag="wim" />
          <ComboBoxItem Content="VHDX 磁盘" Tag="vhdx" />
        </ComboBox>
        <ToggleSwitch x:Name="FastToggle" Header="快速模式" OffContent="标准" OnContent="快速" Toggled="FastToggled" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="OutputBox" PlaceholderText="输出文件（例如 D:\out\tinywin.esd）" Width="560"
                 TextChanged="OutputChanged" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="WorkspaceBox" PlaceholderText="工作目录（用于层链、日志和清单）" Width="560"
                 TextChanged="WorkspaceChanged" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
        <Button x:Name="NextButton" Content="下一步 →" Style="{ThemeResource AccentButtonStyle}" Click="GoNext" />
        <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="Gray" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
