<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyWin2.Gui.Pages.ResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Padding="24,8,24,24" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel x:Name="SuccessPanel" Spacing="10">
                <TextBlock x:Name="SuccessTitle" Text="✔ 构建完成" Style="{ThemeResource TitleTextBlockStyle}" Foreground="DarkGreen"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开输出文件夹" Click="OpenFolder"/>
                    <Button Content="复制诊断信息" Click="CopyDiagnostics"/>
                </StackPanel>
                <TextBlock Text="产物" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,10,0,0"/>
                <TextBlock x:Name="ArtifactsText" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <TextBlock x:Name="LayerSummaryText" Foreground="Gray"/>
            </StackPanel>

            <StackPanel x:Name="FailurePanel" Spacing="10">
                <TextBlock Text="✘ 构建失败" Style="{ThemeResource TitleTextBlockStyle}" Foreground="DarkRed"/>
                <TextBlock Text="失败的层已被丢弃，镜像状态与该步骤执行前一致；工作区与层链已保留用于取证。"
                           TextWrapping="Wrap" Foreground="Gray"/>
                <TextBlock Text="下一步" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="FailureHint" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <Button Content="复制诊断信息" Click="CopyDiagnostics"/>
            </StackPanel>

            <Button Content="← 返回首页（新构建）" Margin="0,16,0,0" Click="Restart"/>
        </StackPanel>
    </ScrollViewer>
</Page>
