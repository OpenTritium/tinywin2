<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyWin2.Gui.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyWin2.Gui.Pages">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24,8,24,16">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
            <TextBlock x:Name="PhaseText" Text="正在准备…" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100"/>
        </StackPanel>

        <ListView x:Name="LogList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ColoredLogLine">
                    <TextBlock Text="{x:Bind Display}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{x:Bind Brush, Mode=OneWay}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="取消构建" Click="CancelBuild"/>
        </StackPanel>
    </Grid>
</Page>
