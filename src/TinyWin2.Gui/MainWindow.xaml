<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TinyWin2.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TinyWin2.Gui.Pages">

    <Grid RowDefinitions="Auto,*">
        <!-- step indicator -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Padding="20,12,20,4">
            <StackPanel x:Name="Step1" Orientation="Horizontal" Spacing="6">
                <Ellipse Width="22" Height="22" VerticalAlignment="Center"/>
                <TextBlock Text="1. 源与输出" Style="{StaticResource StepText}"/>
            </StackPanel>
            <FontIcon Glyph="&#xE76B;" FontSize="12" VerticalAlignment="Center" Foreground="Gray"/>
            <StackPanel x:Name="Step2" Orientation="Horizontal" Spacing="6">
                <Ellipse Width="22" Height="22" VerticalAlignment="Center"/>
                <TextBlock Text="2. 精简项目" Style="{StaticResource StepText}"/>
            </StackPanel>
            <FontIcon Glyph="&#xE76B;" FontSize="12" VerticalAlignment="Center" Foreground="Gray"/>
            <StackPanel x:Name="Step3" Orientation="Horizontal" Spacing="6">
                <Ellipse Width="22" Height="22" VerticalAlignment="Center"/>
                <TextBlock Text="3. 进度" Style="{StaticResource StepText}"/>
            </StackPanel>
            <FontIcon Glyph="&#xE76B;" FontSize="12" VerticalAlignment="Center" Foreground="Gray"/>
            <StackPanel x:Name="Step4" Orientation="Horizontal" Spacing="6">
                <Ellipse Width="22" Height="22" VerticalAlignment="Center"/>
                <TextBlock Text="4. 结果" Style="{StaticResource StepText}"/>
            </StackPanel>
        </StackPanel>

        <Frame x:Name="RootFrame" Grid.Row="1"/>
    </Grid>
</Window>
