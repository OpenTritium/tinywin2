<?xml version="1.0" encoding="utf-8"?>

<Window
  x:Class="TinyWin2.Gui.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid RowDefinitions="Auto,*">
    <!-- step indicator -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Padding="20,12,20,4">
      <StackPanel x:Name="Step1" Orientation="Horizontal" Spacing="6">
        <Ellipse x:Name="Step1Dot" Width="22" Height="22" VerticalAlignment="Center" />
        <TextBlock x:Name="Step1Text" Text="1. 源与输出" Style="{StaticResource StepText}" />
      </StackPanel>
      <FontIcon Glyph="&#xE76B;" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
      <StackPanel x:Name="Step2" Orientation="Horizontal" Spacing="6">
        <Ellipse x:Name="Step2Dot" Width="22" Height="22" VerticalAlignment="Center" />
        <TextBlock x:Name="Step2Text" Text="2. 精简项目" Style="{StaticResource StepText}" />
      </StackPanel>
      <FontIcon Glyph="&#xE76B;" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
      <StackPanel x:Name="Step3" Orientation="Horizontal" Spacing="6">
        <Ellipse x:Name="Step3Dot" Width="22" Height="22" VerticalAlignment="Center" />
        <TextBlock x:Name="Step3Text" Text="3. 进度" Style="{StaticResource StepText}" />
      </StackPanel>
      <FontIcon Glyph="&#xE76B;" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
      <StackPanel x:Name="Step4" Orientation="Horizontal" Spacing="6">
        <Ellipse x:Name="Step4Dot" Width="22" Height="22" VerticalAlignment="Center" />
        <TextBlock x:Name="Step4Text" Text="4. 结果" Style="{StaticResource StepText}" />
      </StackPanel>
    </StackPanel>

    <Frame x:Name="RootFrame" Grid.Row="1" />
  </Grid>
</Window>
